import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset
url = "https://raw.githubusercontent.com/mwaskom/seaborn-data/master/tips.csv"
df = pd.read_csv(url)

# 1. Display the first five rows
print("First five rows:")
print(df.head())

# 2. Check dataset structure
print("\nDataset information:")
df.info()

# 3. Check number of rows and columns
print("\nDataset shape:", df.shape)

# 4. Check data types
print("\nData types:")
print(df.dtypes)

# 5. Check missing values
print("\nMissing values:")
print(df.isnull().sum())

# 6. Check duplicate rows
print("\nDuplicate rows:", df.duplicated().sum())

# 7. Statistical summary
print("\nStatistical summary:")
print(df.describe())

# 8. Ask meaningful questions
print("\nAverage total bill:", df["total_bill"].mean())
print("Average tip:", df["tip"].mean())
print("Highest total bill:", df["total_bill"].max())
print("Average tip by day:")
print(df.groupby("day")["tip"].mean())

# 9. Visualize total bill distribution
plt.figure(figsize=(8, 5))
sns.histplot(df["total_bill"], bins=20, kde=True)
plt.title("Distribution of Total Bills")
plt.xlabel("Total Bill")
plt.ylabel("Frequency")
plt.tight_layout()
plt.show()

# 10. Compare tips across days
plt.figure(figsize=(8, 5))
sns.barplot(data=df, x="day", y="tip", errorbar=None)
plt.title("Average Tip by Day")
plt.xlabel("Day")
plt.ylabel("Average Tip")
plt.tight_layout()
plt.show()

# 11. Explore relationships between variables
plt.figure(figsize=(8, 5))
sns.scatterplot(data=df, x="total_bill", y="tip", hue="sex")
plt.title("Total Bill vs Tip")
plt.tight_layout()
plt.show()

# 12. Detect possible outliers using a boxplot
plt.figure(figsize=(8, 5))
sns.boxplot(data=df, x="total_bill")
plt.title("Outlier Detection in Total Bill")
plt.tight_layout()
plt.show()

# 13. Correlation between numerical variables
numeric_df = df.select_dtypes(include="number")
print("\nCorrelation matrix:")
print(numeric_df.corr())

sns.heatmap(numeric_df.corr(), annot=True, cmap="coolwarm", fmt=".2f")
plt.title("Correlation Heatmap")
plt.tight_layout()
plt.show()

print("\nEDA completed successfully!")
